# AQI India ETL Pipeline - Environment Variables
# Copy this file to .env and adjust values if needed.

# Air Quality API Provider (Open-Meteo Air Quality endpoint)
AQI_API_BASE_URL=https://air-quality-api.open-meteo.com/v1/air-quality

# Optional commercial API key (not required for non-commercial free tier up to 10,000 calls/day)
AQI_API_KEY=

# SQLite Database storage location
AQI_DB_PATH=aqi_india.db

# Offline fixture path for deterministic/offline testing
AQI_FIXTURE_PATH=tests/fixtures/batch_cities_response.json

# HTTP Request Timeout (seconds)
AQI_TIMEOUT_SECONDS=10.0

# Retry Configuration for Transient Failures
AQI_MAX_RETRIES=3
AQI_BACKOFF_FACTOR=1.5

# Pacing delay between sequential city requests (seconds)
AQI_RATE_LIMIT_DELAY=0.2

# Logging Verbosity: DEBUG, INFO, WARNING, ERROR
AQI_LOG_LEVEL=INFO

# Default execution mode: 'fixture' or 'live'
AQI_EXECUTION_MODE=fixture
